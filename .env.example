# Copie este arquivo para .env (cp .env.example .env) e ajuste se precisar.
# O .env NÃO vai para o Git.

# Banco de dados (usado pelo container do Postgres e pela API)
POSTGRES_USER=aprovaenem
POSTGRES_PASSWORD=aprovaenem
POSTGRES_DB=aprovaenem
# "localhost" é para rodar a API fora do Docker (modo desenvolvimento).
# Dentro do Docker Compose, o docker-compose.yml troca para "db" automaticamente.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Portas na sua máquina. Troque se alguma já estiver em uso por outro projeto.
# Se mudar DB_PORT, use o mesmo valor em POSTGRES_PORT (modo desenvolvimento).
# Se mudar WEB_PORT, atualize CORS_ORIGINS; se mudar API_PORT, atualize o VITE_API_URL do frontend/.env.
DB_PORT=5432
API_PORT=8000
WEB_PORT=5173

# Endereços que podem chamar a API pelo navegador (separados por vírgula)
CORS_ORIGINS=http://localhost:5173
